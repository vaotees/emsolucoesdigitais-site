# Copy to .env and fill in. Never commit the real file.

# PostgreSQL (Neon in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin sign-in (Google OAuth via NextAuth). Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Optional
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
REVALIDATE_SECRET=""        # on-demand ISR from scripts (prisma/revalidate-site.js)
BLOB_READ_WRITE_TOKEN=""    # image uploads in the admin (Vercel Blob)
EMAIL_USER=""               # contact form + lead replies (SMTP via Nodemailer)
EMAIL_PASS=""
NEXT_PUBLIC_GA_ID=""
